#version 450
#extension GL_GOOGLE_include_directive : require
// BC7 block decoder. One invocation decodes one 4x4 block of one array layer into RGBA8.
// Written from the BC7 (BPTC) mode definitions; the partition tables are generated from bcdec
// (MIT or Unlicense), see scripts/gen-bc7-tables.py.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Blocks { uint data[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2DArray dst;

layout(push_constant) uniform PC {
    uint word_base;
    uint row_pitch;
    uint slice_pitch;
    uint off_x, off_y;
    uint ext_x, ext_y;
    uint mip_x, mip_y;
} pc;

#include "bc7_tables.glsl"

const uint W2[4] = uint[4](0u, 21u, 43u, 64u);
const uint W3[8] = uint[8](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
const uint W4[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

// colour bits, alpha bits per mode (without p-bits)
const uint CBITS[8] = uint[8](4u, 6u, 5u, 7u, 5u, 7u, 7u, 5u);
const uint ABITS[8] = uint[8](0u, 0u, 0u, 0u, 6u, 8u, 7u, 5u);
const uint HAS_PBITS = 0xCBu;  // modes 0, 1, 3, 6, 7

uvec4 blk;
uint bpos;

uint rd(uint n) {
    if (n == 0u) return 0u;
    uint w = bpos >> 5u;
    uint o = bpos & 31u;
    uint v = blk[w] >> o;
    if (o + n > 32u) v |= blk[w + 1u] << (32u - o);
    bpos += n;
    return v & ((1u << n) - 1u);
}

uint weight(uint bits, uint idx) {
    return bits == 2u ? W2[idx] : (bits == 3u ? W3[idx] : W4[idx]);
}

uint interp(uint a, uint b, uint w) { return (a * (64u - w) + b * w + 32u) >> 6u; }

uint nparts;
uint part;

uint subset_of(uint t) {
    if (nparts == 1u) return 0u;
    if (nparts == 2u) return (BC7_PART2[part] >> t) & 1u;
    return (BC7_PART3[part] >> (2u * t)) & 3u;
}

bool is_anchor(uint t, uint s) {
    if (s == 0u) return t == 0u;
    if (s == 1u) return t == (nparts == 2u ? BC7_ANCHOR2_1[part] : BC7_ANCHOR3_1[part]);
    return t == BC7_ANCHOR3_2[part];
}

void decode_block(uvec4 block, out uvec4 px[16]) {
    blk = block;
    bpos = 0u;

    uint mode = 0u;
    while (mode < 8u) {
        if (rd(1u) != 0u) break;
        mode++;
    }
    if (mode >= 8u) {
        for (uint t = 0u; t < 16u; t++) px[t] = uvec4(0u);
        return;
    }

    nparts = 1u;
    part = 0u;
    uint rot = 0u, idxsel = 0u;
    if (mode == 0u || mode == 1u || mode == 2u || mode == 3u || mode == 7u) {
        nparts = (mode == 0u || mode == 2u) ? 3u : 2u;
        part = rd(mode == 0u ? 4u : 6u);
    }
    uint nep = nparts * 2u;
    if (mode == 4u || mode == 5u) {
        rot = rd(2u);
        if (mode == 4u) idxsel = rd(1u);
    }

    uvec4 ep[6];
    for (uint j = 0u; j < 6u; j++) ep[j] = uvec4(0u);
    for (uint c = 0u; c < 3u; c++)
        for (uint j = 0u; j < nep; j++) ep[j][c] = rd(CBITS[mode]);
    if (ABITS[mode] > 0u)
        for (uint j = 0u; j < nep; j++) ep[j][3] = rd(ABITS[mode]);

    bool has_pbits = ((HAS_PBITS >> mode) & 1u) != 0u;
    if (has_pbits) {
        for (uint j = 0u; j < nep; j++) ep[j] <<= 1u;
        if (mode == 1u) {
            uint p0 = rd(1u), p1 = rd(1u);
            for (uint c = 0u; c < 3u; c++) {
                ep[0][c] |= p0;
                ep[1][c] |= p0;
                ep[2][c] |= p1;
                ep[3][c] |= p1;
            }
        } else {
            for (uint j = 0u; j < nep; j++) ep[j] |= uvec4(rd(1u));
        }
    }

    uint pb = has_pbits ? 1u : 0u;
    for (uint j = 0u; j < nep; j++) {
        uint cb = CBITS[mode] + pb;
        for (uint c = 0u; c < 3u; c++) {
            uint v = ep[j][c] << (8u - cb);
            ep[j][c] = v | (v >> cb);
        }
        if (ABITS[mode] == 0u) {
            ep[j][3] = 255u;
        } else {
            uint ab = ABITS[mode] + pb;
            uint v = ep[j][3] << (8u - ab);
            ep[j][3] = v | (v >> ab);
        }
    }

    uint ib = (mode < 2u) ? 3u : ((mode == 6u) ? 4u : 2u);
    uint ib2 = (mode == 4u) ? 3u : ((mode == 5u) ? 2u : 0u);

    uint idx[16];
    for (uint t = 0u; t < 16u; t++) {
        uint s = subset_of(t);
        idx[t] = rd(is_anchor(t, s) ? ib - 1u : ib);
    }
    uint idx2[16];
    for (uint t = 0u; t < 16u; t++) idx2[t] = 0u;
    if (ib2 != 0u) {
        for (uint t = 0u; t < 16u; t++) idx2[t] = rd(t == 0u ? ib2 - 1u : ib2);
    }

    for (uint t = 0u; t < 16u; t++) {
        uint s = subset_of(t);
        uvec4 e0 = ep[2u * s], e1 = ep[2u * s + 1u];
        uint wc = weight(ib, idx[t]);
        uint wa = wc;
        if (ib2 != 0u) {
            uint w2 = weight(ib2, idx2[t]);
            if (idxsel == 0u) {
                wa = w2;
            } else {
                wa = wc;
                wc = w2;
            }
        }
        uint r = interp(e0.r, e1.r, wc);
        uint g = interp(e0.g, e1.g, wc);
        uint b = interp(e0.b, e1.b, wc);
        uint a = interp(e0.a, e1.a, wa);
        if (rot == 1u) { uint x = a; a = r; r = x; }
        else if (rot == 2u) { uint x = a; a = g; g = x; }
        else if (rot == 3u) { uint x = a; a = b; b = x; }
        px[t] = uvec4(r, g, b, a);
    }
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uvec2 blocks = (uvec2(pc.ext_x, pc.ext_y) + 3u) / 4u;
    if (g.x >= blocks.x || g.y >= blocks.y) return;

    uint base = pc.word_base + (g.z * pc.slice_pitch + g.y * pc.row_pitch + g.x) * 4u;
    uvec4 block = uvec4(data[base], data[base + 1u], data[base + 2u], data[base + 3u]);
    uvec4 px[16];
    decode_block(block, px);

    for (uint t = 0u; t < 16u; t++) {
        uint x = pc.off_x + g.x * 4u + (t & 3u);
        uint y = pc.off_y + g.y * 4u + (t >> 2u);
        if (x >= pc.off_x + pc.ext_x || y >= pc.off_y + pc.ext_y || x >= pc.mip_x || y >= pc.mip_y) continue;
        imageStore(dst, ivec3(int(x), int(y), int(g.z)), vec4(px[t]) / 255.0);
    }
}
